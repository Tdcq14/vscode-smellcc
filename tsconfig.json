{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "dist",  // <--- 必须是 dist，为了和 package.json 对应！
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "lib": ["ES2020"],
    "types": ["node", "vscode", "mocha"],
    "esModuleInterop": true
  },
  "exclude": ["node_modules", ".vscode-test"]
}