{
  "name": "smellcc",
  "displayName": "SMELLCC: Refactoring Tool",
  "description": "LLM-based Code Smell Refactoring Tool",
  "version": "0.0.2",
  "publisher": "zyhelm", 
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:python"],
  
  "main": "./dist/extension.js", 
  
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "extensionDependencies": [
    "SonarSource.sonarlint-vscode"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smellcc.refactor",
        "title": "SMELLCC: Refactor Code Smell"
      }
    ],
    "configuration": {
      "title": "SMELLCC Configuration",
      "properties": {
        "smellcc.apiKey": {
            "type": "string",
            "default": "",
            "description": "LLM API Key"
        },
        "smellcc.apiBaseUrl": {
            "type": "string",
            "default": "https://api.deepseek.com",
            "description": "API Base URL"
        },
        "smellcc.model": {
            "type": "string",
            "default": "deepseek-coder",
            "description": "Model Name"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.106.1",
    "typescript": "^5.9.3",
    "vsce": "^2.15.0"
  }
}